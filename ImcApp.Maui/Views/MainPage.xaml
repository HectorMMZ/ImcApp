<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImcApp.Maui.Views.MainPage"
             Title="Indice de masa corporal">
    
    <ScrollView>
        <VerticalStackLayout 
            Padding="16" 
            Spacing="24">
            <Border 
                Stroke="LightGray" 
                StrokeThickness="2">
                <VerticalStackLayout>
                    <Grid
                         RowDefinitions="*, *"
                         ColumnDefinitions="*,*"
                         RowSpacing="8"
                         ColumnSpacing="4"
                         Padding="16">
                    <Label Text="Proporcione el peso en kilogramos: "
                           Grid.Column="0"
                           Grid.Row="0"
                           VerticalOptions="Center"/>
                    <Entry BackgroundColor="WhiteSmoke"
                           Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding Path=Peso}"
                           Keyboard="Numeric" 
                           ClearButtonVisibility="WhileEditing"
                           TextColor="Black"/>
                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Text="Proporcione la estatura en metros: "
                           VerticalOptions="Center"/>
                    <Entry BackgroundColor="LightCyan" 
                           Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Path=Estatura}" 
                           Keyboard="Numeric" 
                           ClearButtonVisibility="WhileEditing"
                           TextColor="Black"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout 
                HorizontalOptions="Center" 
                Spacing="24">
                <Button Text="Calcular" 
                        MinimumWidthRequest="80" 
                        
                        Command="{Binding Path=CalcularCommand}"/>
                <Button Text="Limpiar" 
                        MinimumWidthRequest="80" 
                        
                        Command="{Binding Path=LimpiarCommand}"/>
            </HorizontalStackLayout>

            <Border 
                Stroke="LightGray" 
                StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout 
                    Padding="16" 
                    Spacing="6">
                    <Label Text="El indice de masa corporal de la persona es: "/>
                    <Label Text="{Binding Path=Imc}" 
                           FontSize="Medium" FontAttributes="Bold" 
                           x:Name="ImcLabel"/>
                    <Label Text="La situacion nutricional de la persona es: "/>
                    <Label Text="{Binding Path=SituacionNutricional}" 
                           HorizontalOptions="Center" 
                           FontSize="Medium" FontAttributes="Bold" 
                           x:Name="SituacionNutricionalLabel"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    
    <!--El contentpage es toda la ventana-->
</ContentPage>