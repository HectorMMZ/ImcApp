<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ImcApp.Maui.Views.MainPage"
             Title="Indice de masa corporal">
    
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="24">
            <Border Stroke="LightGray" StrokeThickness="2">
                <VerticalStackLayout Padding="16" Spacing="6">
                    <Label Text="Proporcione el peso en kilogramos:" />
                    <Entry BackgroundColor="WhiteSmoke" x:Name="PesoLabel" Keyboard="Numeric" ClearButtonVisibility="WhileEditing"/>
                    <Label Text="Proporcione la estatura en metros"/>
                    <Entry BackgroundColor="LightCyan" x:Name="EstaturaLabel" Keyboard="Numeric" ClearButtonVisibility="WhileEditing"/>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="24">
                <Button Text="Calcular" MinimumWidthRequest="80" Clicked="OnCalcularButtonClicked"/>
                <Button Text="Limpiar" MinimumWidthRequest="80" Clicked="OnLimpiarButtonClicked"/>
            </HorizontalStackLayout>

            <Border Stroke="LightGray" StrokeThickness="2">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Padding="16" Spacing="6">
                    <Label Text="El indice de masa corporal de la persona es: "/>
                    <Label Text="23.4567" HorizontalOptions="Center" FontSize="Medium" FontAttributes="Bold" x:Name="ImcLabel"/>
                    <Label Text="La situacion nutricional de la persona es: "/>
                    <Label Text="Peso normal" HorizontalOptions="Center" FontSize="Medium" FontAttributes="Bold" x:Name="SituacionNutricionalLabel"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    
    <!--El contentpage es toda la ventana-->
</ContentPage>